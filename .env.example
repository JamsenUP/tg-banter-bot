# ==========================================
# КОНФИГУРАЦИЯ TELEGRAM И НЕЙРОСЕТИ
# ==========================================

# 1. Токен вашего бота от @BotFather в Telegram
TELEGRAM_BOT_TOKEN="ВАШ_ТОКЕН_БОТА_ОТСЮДА"

# 2. Провайдер нейросети (LLM)

# --- Вариант А: Локальная Ollama (Полностью бесплатно и без цензуры) ---
# Установите Ollama с https://ollama.com и выполните: ollama run llama3
LLM_BASE_URL="http://localhost:11434/v1"
LLM_API_KEY="ollama"
MODEL_NAME="llama3:latest"

# --- Вариант Б: OpenRouter (Облачные модели, включая uncensored / deepseek / mistral) ---
# LLM_BASE_URL="https://openrouter.ai/api/v1"
# LLM_API_KEY="sk-or-v1-..."
# MODEL_NAME="mistralai/mistral-nemo"

# --- Вариант В: DeepSeek API ---
# LLM_BASE_URL="https://api.deepseek.com/v1"
# LLM_API_KEY="sk-..."
# MODEL_NAME="deepseek-chat"

# 3. Настройки поведения
TEMPERATURE=0.85
MAX_TOKENS=250
MAX_HISTORY_LEN=12
RANDOM_REPLY_CHANCE=0.0

# 4. Кастомный системный промпт (характер и тон бота)
SYSTEM_PROMPT="Ты — дерзкий, саркастичный и острый на язык участник закрытого пацанского чата. Твой стиль — постоянный трэш-ток, жесткие подколы, ирония и едкий юмор. Общайся на равных, без вежливости, отвечай дерзко и коротко (1-3 предложения)."
